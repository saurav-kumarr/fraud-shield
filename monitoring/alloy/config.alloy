// Collect logs from all services
local.file_match "service_logs" {
  path_targets = [
    {
      "__path__" = "/var/log/*.log",
      "job"      = "fraud-shield-services",
    },
  ]
}

loki.source.file "service_logs" {
  targets    = local.file_match.service_logs.targets
  forward_to = [loki.write.default.receiver]
}

// Spring Boot application logs
loki.source.journal "systemd" {
  forward_to = [loki.write.default.receiver]
  labels = {
    job = "fraud-shield",
  }
}

// Write to Loki
loki.write "default" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}

// Collect metrics from services
prometheus.scrape "services" {
  targets = [
    {"__address__" = "host.docker.internal:8080",
     "job" = "api-gateway"},
    {"__address__" = "host.docker.internal:8081",
     "job" = "transaction-service"},
    {"__address__" = "host.docker.internal:8082",
     "job" = "fraud-detection-service"},
    {"__address__" = "host.docker.internal:8083",
     "job" = "alert-service"},
    {"__address__" = "host.docker.internal:8084",
     "job" = "user-service"},
    {"__address__" = "host.docker.internal:8085",
     "job" = "report-service"},
  ]
  metrics_path = "/actuator/prometheus"
  forward_to   = [prometheus.remote_write.default.receiver]
}

prometheus.remote_write "default" {
  endpoint {
    url = "http://prometheus:9090/api/v1/write"
  }
}